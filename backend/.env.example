# Copy this file to ".env" (same folder) and fill in the values.
# Serial port of the ESP32. Windows example: COM3   Mac/Linux example: /dev/ttyUSB0
# Leave EMPTY to run without hardware (use the Simulate Tap dropdown in the UI).
SERIAL_PORT=
SERIAL_BAUD=115200

# Gemini API key from https://aistudio.google.com  (leave empty to use template explanations only)
GEMINI_API_KEY=
# Check the current model name in Google AI Studio if this one stops working
GEMINI_MODEL=gemini-2.5-flash
USE_LLM=true
